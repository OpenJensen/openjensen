{
  "name": "openjensen-workspace",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @openjensen/web dev",
    "build:web": "pnpm --filter @openjensen/web build",
    "check:web": "pnpm --filter @openjensen/web typecheck",
    "test:web": "playwright test",
    "test:diagnostics": "playwright test --config playwright.diagnostics.config.ts",
    "generate:client": "openapi-typescript packages/core/openapi.json -o apps/web/src/lib/api.generated.ts",
    "test:web:pure": "playwright test --config playwright.pure.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:web": "eslint apps/web/src"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.71.0"
  }
}
