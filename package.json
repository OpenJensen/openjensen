{
  "name": "firebird-workspace",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=24.21.0 <25" },
  "scripts": {
    "dev:web": "pnpm --filter @firebird/web dev",
    "build:web": "pnpm --filter @firebird/web build",
    "check:web": "pnpm --filter @firebird/web typecheck",
    "generate:client": "openapi-typescript packages/core/openapi.json -o apps/web/src/lib/api.generated.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
