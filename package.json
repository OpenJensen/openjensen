{
  "name": "firebird-workspace",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @firebird/web dev",
    "build:web": "pnpm --filter @firebird/web build",
    "check:web": "pnpm --filter @firebird/web typecheck",
    "test:web": "playwright test",
    "test:diagnostics": "playwright test --config playwright.diagnostics.config.ts",
    "generate:client": "openapi-typescript packages/core/openapi.json -o apps/web/src/lib/api.generated.ts",
    "test:web:pure": "playwright test --config playwright.pure.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "openapi-typescript": "7.13.0"
  }
}
