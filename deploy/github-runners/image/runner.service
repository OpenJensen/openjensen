[Unit]
Description=One-job GitHub Actions runner
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/actions-runner/run.sh

[Service]
Type=simple
User=runner
WorkingDirectory=/opt/actions-runner
Environment=UV_PYTHON_INSTALL_DIR=/opt/uv/python
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
ExecStart=/usr/local/sbin/firebird-runner
# Power off after success or startup failure; the controller removes stopped VMs.
ExecStopPost=+/usr/bin/systemctl --no-block poweroff
Restart=no
TimeoutStopSec=30
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
