{
  "components": {
    "schemas": {
      "Capability": {
        "additionalProperties": false,
        "description": "Application availability plus separately scoped support evidence.\n\nExplicit empty support denotes unknown target coverage, not tested support.\nCallers must supply the field; CAP-001 must populate reviewed target records.",
        "properties": {
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "operation": {
            "enum": [
              "dataset.inspect",
              "dataset.inspect.local",
              "policy.finetune",
              "policy.distill",
              "policy.quantize",
              "policy.evaluate",
              "policy.run"
            ],
            "title": "Operation",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "stage": {
            "enum": [
              "Dataset",
              "Fine-tune",
              "Distill",
              "Quantize",
              "Evaluate",
              "Run"
            ],
            "title": "Stage",
            "type": "string"
          },
          "status": {
            "enum": [
              "available",
              "planned"
            ],
            "title": "Status",
            "type": "string"
          },
          "support": {
            "items": {
              "$ref": "#/components/schemas/CapabilitySupport"
            },
            "title": "Support",
            "type": "array"
          }
        },
        "required": [
          "stage",
          "operation",
          "status",
          "description",
          "support"
        ],
        "title": "Capability",
        "type": "object"
      },
      "CapabilityEvidence": {
        "additionalProperties": false,
        "description": "Reference to reviewed evidence; validation does not execute or verify it.",
        "properties": {
          "device_name": {
            "minLength": 1,
            "title": "Device Name",
            "type": "string"
          },
          "recorded_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "title": "Recorded At",
            "type": "string"
          },
          "reference": {
            "minLength": 1,
            "title": "Reference",
            "type": "string"
          },
          "runtime": {
            "minLength": 1,
            "title": "Runtime",
            "type": "string"
          },
          "source_revision": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Source Revision",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "source_revision",
          "runtime",
          "device_name",
          "recorded_at"
        ],
        "title": "CapabilityEvidence",
        "type": "object"
      },
      "CapabilitySupport": {
        "additionalProperties": false,
        "description": "Evidence for one parent operation on one concrete execution target.",
        "properties": {
          "backend": {
            "enum": [
              "metadata",
              "lerobot",
              "openvla_oft",
              "vla_cpp"
            ],
            "title": "Backend",
            "type": "string"
          },
          "device": {
            "enum": [
              "cpu",
              "cuda"
            ],
            "title": "Device",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/CapabilityEvidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "evidence_state": {
            "enum": [
              "planned",
              "untested",
              "tested",
              "unsupported"
            ],
            "title": "Evidence State",
            "type": "string"
          },
          "os": {
            "enum": [
              "linux",
              "windows",
              "macos"
            ],
            "title": "Os",
            "type": "string"
          }
        },
        "required": [
          "backend",
          "os",
          "device",
          "evidence_state"
        ],
        "title": "CapabilitySupport",
        "type": "object"
      },
      "DatasetProfile": {
        "additionalProperties": false,
        "properties": {
          "features": {
            "additionalProperties": true,
            "minProperties": 1,
            "title": "Features",
            "type": "object"
          },
          "format": {
            "enum": [
              "lerobot_v2",
              "lerobot_v3"
            ],
            "title": "Format",
            "type": "string"
          },
          "fps": {
            "exclusiveMinimum": 0.0,
            "title": "Fps",
            "type": "number"
          },
          "inspected_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "title": "Inspected At",
            "type": "string"
          },
          "inspection_scope": {
            "const": "metadata_only",
            "default": "metadata_only",
            "title": "Inspection Scope",
            "type": "string"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "metadata_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Metadata Sha256",
            "type": "string"
          },
          "repo_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "pattern": "^[\\w.-]+/[\\w.-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Id"
          },
          "revision": {
            "minLength": 1,
            "title": "Revision",
            "type": "string"
          },
          "robot_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Robot Type"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "source": {
            "enum": [
              "huggingface",
              "local"
            ],
            "title": "Source",
            "type": "string"
          },
          "total_episodes": {
            "minimum": 0.0,
            "title": "Total Episodes",
            "type": "integer"
          },
          "total_frames": {
            "minimum": 0.0,
            "title": "Total Frames",
            "type": "integer"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "source",
          "revision",
          "format",
          "total_episodes",
          "total_frames",
          "fps",
          "features",
          "metadata_sha256",
          "inspected_at",
          "warnings"
        ],
        "title": "DatasetProfile",
        "type": "object"
      },
      "Evaluation": {
        "additionalProperties": false,
        "properties": {
          "final_states": {
            "items": {
              "type": "integer"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Final States",
            "type": "array"
          },
          "initial_states": {
            "items": {
              "type": "integer"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Initial States",
            "type": "array"
          },
          "mode": {
            "default": "engine",
            "enum": [
              "engine",
              "libero"
            ],
            "title": "Mode",
            "type": "string"
          },
          "repetitions": {
            "default": 10,
            "maximum": 1000.0,
            "minimum": 2.0,
            "title": "Repetitions",
            "type": "integer"
          },
          "seed": {
            "default": 42,
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "steps": {
            "default": 500,
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Steps",
            "type": "integer"
          },
          "task_id": {
            "default": 0,
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Task Id",
            "type": "integer"
          },
          "warmups": {
            "default": 3,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Warmups",
            "type": "integer"
          }
        },
        "title": "Evaluation",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IntakeRequest": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "repo_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "pattern": "^[\\w.-]+/[\\w.-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Id"
          },
          "revision": {
            "default": "main",
            "maxLength": 200,
            "minLength": 1,
            "title": "Revision",
            "type": "string"
          },
          "source": {
            "default": "huggingface",
            "enum": [
              "huggingface",
              "local"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "title": "IntakeRequest",
        "type": "object"
      },
      "Job": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "default": "dataset.inspect",
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "project_id": {
            "minLength": 1,
            "title": "Project Id",
            "type": "string"
          },
          "request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IntakeRequest"
              },
              {
                "$ref": "#/components/schemas/PolicyRequest"
              }
            ],
            "title": "Request"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DatasetProfile"
              },
              {
                "$ref": "#/components/schemas/LifecycleResult"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "status": {
            "default": "queued",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "interrupted"
            ],
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "request",
          "created_at",
          "updated_at"
        ],
        "title": "Job",
        "type": "object"
      },
      "JobEvent": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "stage",
          "message",
          "timestamp"
        ],
        "title": "JobEvent",
        "type": "object"
      },
      "LifecycleResult": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/PolicyArtifact"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "decision": {
            "default": "completed",
            "enum": [
              "completed",
              "diagnostics_only",
              "no_feasible_candidate",
              "validated"
            ],
            "title": "Decision",
            "type": "string"
          },
          "reports": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Reports",
            "type": "array"
          },
          "selected_artifact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Artifact Id"
          }
        },
        "title": "LifecycleResult",
        "type": "object"
      },
      "Limits": {
        "additionalProperties": false,
        "properties": {
          "max_p95_ms": {
            "default": 1000.0,
            "exclusiveMinimum": 0.0,
            "title": "Max P95 Ms",
            "type": "number"
          },
          "max_peak_device_mib": {
            "default": 8192.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Peak Device Mib",
            "type": "number"
          },
          "max_success_drop": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Max Success Drop",
            "type": "number"
          },
          "min_success_rate": {
            "default": 1.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Success Rate",
            "type": "number"
          }
        },
        "title": "Limits",
        "type": "object"
      },
      "PolicyArtifact": {
        "additionalProperties": false,
        "properties": {
          "file_bytes": {
            "minimum": 0.0,
            "title": "File Bytes",
            "type": "integer"
          },
          "format": {
            "enum": [
              "gguf",
              "training_checkpoint",
              "native_checkpoint",
              "deployment_package"
            ],
            "title": "Format",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "manifest_sha256": {
            "title": "Manifest Sha256",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "parent_ids": {
            "items": {
              "type": "string"
            },
            "title": "Parent Ids",
            "type": "array"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "job_id",
          "label",
          "format",
          "path",
          "manifest_sha256",
          "file_bytes"
        ],
        "title": "PolicyArtifact",
        "type": "object"
      },
      "PolicyRequest": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifact Id"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Precision"
            },
            "maxItems": 4,
            "minItems": 2,
            "title": "Candidates",
            "type": "array"
          },
          "dataset_job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset Job Id"
          },
          "evaluation": {
            "$ref": "#/components/schemas/Evaluation"
          },
          "limits": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Limits"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation": {
            "enum": [
              "policy.import",
              "policy.finetune",
              "policy.export",
              "policy.quantize",
              "policy.evaluate",
              "policy.run",
              "policy.workflow"
            ],
            "title": "Operation",
            "type": "string"
          },
          "precision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Precision"
              },
              {
                "type": "null"
              }
            ]
