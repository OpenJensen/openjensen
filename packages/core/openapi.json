          "resume_job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume Job Id"
          },
          "runtime_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\w-]+$",
            "title": "Runtime Id",
            "type": "string"
          },
          "source_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "pattern": "^[\\w-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "timeout_seconds": {
            "default": 7200,
            "maximum": 86400.0,
            "minimum": 30.0,
            "title": "Timeout Seconds",
            "type": "integer"
          },
          "training": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Training"
          },
          "training_method": {
            "default": "lora",
            "pattern": "^[\\w-]+$",
            "title": "Training Method",
            "type": "string"
          }
        },
        "required": [
          "operation",
          "runtime_id"
        ],
        "title": "PolicyRequest",
        "type": "object"
      },
      "Precision": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "default": "Q4_0",
