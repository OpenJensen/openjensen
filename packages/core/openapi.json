          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "operation": {
            "enum": [
              "dataset.inspect",
              "dataset.inspect.local",
              "policy.finetune",
              "policy.distill",
              "policy.quantize",
              "policy.evaluate",
              "policy.run"
