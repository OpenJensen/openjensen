    def "materials"
    {
        def Material "plastic"
        {
            token outputs:surface.connect = </SO101/materials/plastic/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.85, 0.8)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "motor"
        {
            token outputs:surface.connect = </SO101/materials/motor/surface.outputs:surface>

            def Shader "surface"
