FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

# LeRobot 0.4.3 requires torch<2.8. Keep this experiment isolated from the host
# and use a ModelOpt release whose published requirements permit torch 2.7.
RUN python -m pip install --no-cache-dir \
    torch==2.7.1 torchvision==0.22.1 nvidia-modelopt==0.41.0 \
    transformers==4.57.1 accelerate==1.15.0 diffusers==0.35.2 \
    numpy==1.26.4 safetensors==0.8.0 draccus==0.10.0 \
    einops==0.8.1 datasets==4.1.1 gymnasium==1.1.1 av==15.1.0 \
    deepdiff==8.6.2 opencv-python-headless==4.11.0.86 \
    pyserial jsonlines wandb termcolor
RUN python -m pip install --no-cache-dir --no-deps lerobot==0.4.3
RUN python -m pip install --no-cache-dir imageio==2.37.4 imageio-ffmpeg==0.6.0
RUN python -m pip install --no-cache-dir num2words==0.5.14
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4
WORKDIR /workspace
